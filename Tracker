    <style>
        :root {
            --primary: #1a365d;
            --primary-light: #2c5282;
            --accent: #c53030;
            --accent-light: #e53e3e;
            --bg: #f7fafc;
            --card-bg: #ffffff;
            --text: #2d3748;
            --text-light: #718096;
            --border: #e2e8f0;
            --shadow: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -1px rgba(0,0,0,0.06);
            --shadow-lg: 0 10px 15px -3px rgba(0,0,0,0.1), 0 4px 6px -2px rgba(0,0,0,0.05);
            --youtube: #ff0000;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background: var(--bg);
            color: var(--text);
            line-height: 1.6;
        }
        header {
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
            color: white;
            padding: 2rem 1rem;
            text-align: center;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: var(--shadow-lg);
        }
        header h1 { font-size: 1.75rem; font-weight: 700; margin-bottom: 0.25rem; letter-spacing: -0.025em; }
        header p { opacity: 0.9; font-size: 0.95rem; }
        .search-container { max-width: 600px; margin: 1.5rem auto 0; position: relative; }
        .search-container input {
            width: 100%;
            padding: 0.875rem 1rem 0.875rem 2.75rem;
            border: none;
            border-radius: 9999px;
            font-size: 1rem;
            background: rgba(255,255,255,0.95);
            color: var(--text);
            box-shadow: var(--shadow);
            transition: box-shadow 0.2s;
        }
        .search-container input:focus { outline: none; box-shadow: 0 0 0 3px rgba(255,255,255,0.4), var(--shadow); }
        .search-container svg {
            position: absolute;
            left: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-light);
            width: 1.25rem;
            height: 1.25rem;
        }
        .stats-bar {
            background: white;
            border-bottom: 1px solid var(--border);
            padding: 0.75rem 1rem;
            display: flex;
            justify-content: center;
            gap: 2rem;
            flex-wrap: wrap;
            font-size: 0.875rem;
            color: var(--text-light);
        }
        .stats-bar span strong { color: var(--primary); font-weight: 600; }
        main { max-width: 900px; margin: 0 auto; padding: 1.5rem 1rem 3rem; }
        .city-card {
            background: var(--card-bg);
            border-radius: 12px;
            box-shadow: var(--shadow);
            margin-bottom: 1rem;
            overflow: hidden;
            transition: box-shadow 0.2s, transform 0.2s;
            border: 1px solid var(--border);
        }
        .city-card:hover { box-shadow: var(--shadow-lg); transform: translateY(-1px); }
        .city-header {
            background: linear-gradient(90deg, #f8fafc 0%, #edf2f7 100%);
            padding: 1rem 1.25rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            border-bottom: 1px solid transparent;
            transition: border-color 0.2s;
            user-select: none;
        }
        .city-header:hover { border-bottom-color: var(--border); }
        .city-header.active { border-bottom-color: var(--border); }
        .city-name { font-size: 1.125rem; font-weight: 700; color: var(--primary); display: flex; align-items: center; gap: 0.5rem; }
        .city-rank {
            background: var(--primary);
            color: white;
            font-size: 0.75rem;
            font-weight: 700;
            width: 1.75rem;
            height: 1.75rem;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }
        .seat-count { font-size: 0.8rem; color: var(--text-light); font-weight: 500; }
        .toggle-icon {
            width: 1.25rem;
            height: 1.25rem;
            color: var(--text-light);
            transition: transform 0.3s ease;
            flex-shrink: 0;
            margin-left: 0.5rem;
        }
        .toggle-icon.rotated { transform: rotate(180deg); }
        .city-body { display: none; padding: 0; }
        .city-body.open { display: block; animation: slideDown 0.25s ease; }
        @keyframes slideDown { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: translateY(0); } }
        .seat-section { padding: 1rem 1.25rem; border-bottom: 1px solid var(--border); }
        .seat-section:last-child { border-bottom: none; }
        .seat-title {
            font-size: 0.875rem;
            font-weight: 700;
            color: var(--accent);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 0.75rem;
            display: flex;
            align-items: center;
            gap: 0.375rem;
        }
        .seat-title .vote-note {
            font-size: 0.7rem;
            font-weight: 600;
            color: white;
            background: var(--accent);
            padding: 0.125rem 0.5rem;
            border-radius: 9999px;
            text-transform: none;
            letter-spacing: 0;
        }
        .candidate-profile {
            background: #f8fafc;
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 0.875rem 1rem;
            margin-bottom: 0.5rem;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 1rem;
        }
        .candidate-profile:last-child { margin-bottom: 0; }
        .candidate-name {
            font-size: 1rem;
            font-weight: 600;
            color: var(--text);
            margin-bottom: 0.25rem;
        }
        .candidate-party {
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--primary);
            background: #e2e8f0;
            padding: 0.125rem 0.5rem;
            border-radius: 4px;
            display: inline-block;
            margin-top: 0.25rem;
        }
        .candidate-links {
            display: flex;
            gap: 0.5rem;
            flex-shrink: 0;
        }
        .candidate-links a {
            display: inline-flex;
            align-items: center;
            gap: 0.375rem;
            padding: 0.375rem 0.75rem;
            border-radius: 6px;
            font-size: 0.8rem;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.15s;
        }
        .iepn-link {
            background: #fee2e2;
            color: var(--youtube);
            border: 1px solid #fecaca;
        }
        .iepn-link:hover { background: #fecaca; }
        .social-link {
            background: #e0e7ff;
            color: var(--primary);
            border: 1px solid #c7d2fe;
        }
        .social-link:hover { background: #c7d2fe; }
        .no-results { text-align: center; padding: 3rem 1rem; color: var(--text-light); }
        .no-results svg { width: 3rem; height: 3rem; margin-bottom: 1rem; opacity: 0.4; }
        .no-results h3 { font-size: 1.125rem; color: var(--text); margin-bottom: 0.25rem; }
        footer { text-align: center; padding: 2rem 1rem; color: var(--text-light); font-size: 0.8rem; border-top: 1px solid var(--border); background: white; }
        @media (max-width: 640px) {
            header h1 { font-size: 1.375rem; }
            .city-name { font-size: 1rem; }
            .candidate-profile { flex-direction: column; gap: 0.75rem; }
            .candidate-links { width: 100%; }
            .candidate-links a { flex: 1; justify-content: center; }
            .stats-bar { gap: 1rem; }
        }
        .highlight { background: #fef3c7; padding: 0 2px; border-radius: 2px; }
    </style>
