        let totalSeats = 0;
        let totalCandidates = 0;
        electionData.forEach(city => {
            city.seats.forEach(seat => {
                totalSeats++;
                totalCandidates += seat.candidates.length;
            });
        });
        document.getElementById('seatCount').textContent = totalSeats;
        document.getElementById('candidateCount').textContent = totalCandidates;

        const cityList = document.getElementById('cityList');
        const searchInput = document.getElementById('searchInput');
        const noResults = document.getElementById('noResults');

        function getVoteNote(seatTitle) {
            const lower = seatTitle.toLowerCase();
            if (lower.includes('top two')) return 'Vote for up to 2';
            if (lower.includes('top three')) return 'Vote for up to 3';
            return null;
        }

        function escapeRegex(str) {
            return str.replace(/[.*+?^${}()|[\]\]/g, '\$&');
        }

        function renderCities(cities, highlightTerm) {
            highlightTerm = highlightTerm || '';
            cityList.innerHTML = '';

            if (cities.length === 0) {
                noResults.style.display = 'block';
                return;
            }
            noResults.style.display = 'none';

            cities.forEach(city => {
                const card = document.createElement('div');
                card.className = 'city-card';

                const seatLabel = city.seats.length === 1 ? '1 seat' : city.seats.length + ' seats';
                const candidateTotal = city.seats.reduce((sum, s) => sum + s.candidates.length, 0);

                let cityNameHtml = city.name;
                if (highlightTerm) {
                    const regex = new RegExp('(' + escapeRegex(highlightTerm) + ')', 'gi');
                    cityNameHtml = city.name.replace(regex, '<span class="highlight">$1</span>');
                }

                let seatsHtml = '';
                city.seats.forEach(seat => {
                    const voteNote = getVoteNote(seat.title);
                    let candidatesHtml = '';
                    seat.candidates.forEach(c => {
                        candidatesHtml += '<span class="candidate-tag">' + c + '</span>';
                    });
                    seatsHtml += '<div class="seat-section">' +
                        '<div class="seat-title">' + seat.title +
                        (voteNote ? '<span class="vote-note">' + voteNote + '</span>' : '') +
                        '</div>' +
                        '<div class="candidates-list">' + candidatesHtml + '</div>' +
                        '</div>';
                });

                card.innerHTML = '<div class="city-header" onclick="toggleCity(this)">' +
                    '<div class="city-name">' +
                    '<span class="city-rank">' + city.rank + '</span>' +
                    '<span>' + cityNameHtml + '</span>' +
                    '</div>' +
                    '<div style="display: flex; align-items: center; gap: 0.75rem;">' +
                    '<span class="seat-count">' + seatLabel + ' &middot; ' + candidateTotal + ' candidate' + (candidateTotal !== 1 ? 's' : '') + '</span>' +
                    '<svg class="toggle-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">' +
                    '<path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />' +
                    '</svg>' +
                    '</div>' +
                    '</div>' +
                    '<div class="city-body">' + seatsHtml + '</div>';

                cityList.appendChild(card);
            });

            document.getElementById('cityCount').textContent = cities.length;
        }

        function toggleCity(header) {
            const body = header.nextElementSibling;
            const icon = header.querySelector('.toggle-icon');
            const isOpen = body.classList.contains('open');

            if (isOpen) {
                body.classList.remove('open');
                icon.classList.remove('rotated');
                header.classList.remove('active');
            } else {
                body.classList.add('open');
                icon.classList.add('rotated');
                header.classList.add('active');
            }
        }

        searchInput.addEventListener('input', function(e) {
            const term = e.target.value.trim().toLowerCase();
            if (!term) {
                renderCities(electionData);
                return;
            }

            const filtered = electionData.filter(city => 
                city.name.toLowerCase().includes(term)
            );
            renderCities(filtered, term);
        });

        renderCities(electionData);
    </script>
